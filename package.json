{
  "name": "argocast",
  "productName": "argocast",
  "version": "0.2.0",
  "description": "Screen-cast sender compatible with Lango/XBH interactive panels (LRTSP/2.0).",
  "author": "argocast",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "argocast": "src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "app": "electron .",
    "smoke": "node scripts/smoke.js",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "mock-panel": "node mock/panel.js",
    "cast": "node src/cli.js cast",
    "discover": "node src/cli.js discover"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "multicast-dns": "^7.2.5"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "ffmpeg-static": "5.3.0"
  },
  "build": {
    "appId": "app.argocast.sender",
    "productName": "argocast",
    "copyright": "argocast",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**",
      "electron/**",
      "mock/**",
      "build/icon.png",
      "!**/*.test.js"
    ],
    "asarUnpack": [
      "src/inject/**"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "extraResources": [
        { "from": "node_modules/ffmpeg-static/ffmpeg.exe", "to": "ffmpeg.exe" },
        { "from": "node_modules/ffmpeg-static/LICENSE", "to": "ffmpeg-LICENSE.txt" }
      ]
    },
    "mac": {
      "target": [{ "target": "dmg" }],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        { "from": "node_modules/ffmpeg-static/ffmpeg", "to": "ffmpeg" },
        { "from": "node_modules/ffmpeg-static/LICENSE", "to": "ffmpeg-LICENSE.txt" }
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "argocast mencari dan terhubung ke panel interaktif di jaringan lokal Anda.",
        "NSBonjourServices": ["_airgo._tcp"],
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "dmg": {
      "artifactName": "argocast-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "argocast",
      "runAfterFinish": true,
      "artifactName": "argocast-Setup-${version}.${ext}",
      "installerLanguages": ["id_ID", "en_US"],
      "language": "1057"
    }
  }
}
